diff --git a/hw/arm/nucleo_l431rb.c b/hw/arm/nucleo_l431rb.c
new file mode 100644
index 0000000..aa1bacf
--- /dev/null
+++ b/hw/arm/nucleo_l431rb.c
@@ -0,0 +1,106 @@
+/*
+ * ST NUCLEO-L431RB board (STM32L431RB)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * USART2 (PA2/PA3) is the ST-LINK virtual COM port. User LED LD3 is PB13.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/core/boards.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/arm/stm32l4x1_soc.h"
+#include "hw/gpio/stm32l4x5_gpio.h"
+#include "hw/misc/led.h"
+#include "chardev/char.h"
+
+#define TYPE_NUCLEO_L431RB MACHINE_TYPE_NAME("nucleo-l431rb")
+OBJECT_DECLARE_SIMPLE_TYPE(NucleoL431rbMachineState, NUCLEO_L431RB)
+
+#define NUCLEO_LED_PIN (1 * GPIO_NUM_PINS + 13) /* PB13 */
+
+typedef struct NucleoL431rbMachineState {
+    MachineState parent_obj;
+    Stm32l4x1SocState soc;
+    LEDState led;
+    char *trace;
+} NucleoL431rbMachineState;
+
+static void nucleo_l431rb_init(MachineState *machine)
+{
+    NucleoL431rbMachineState *s = NUCLEO_L431RB(machine);
+    const Stm32l4x1SocClass *sc;
+    DeviceState *led;
+
+    object_initialize_child(OBJECT(machine), "soc", &s->soc,
+                            TYPE_STM32L4X1RB_SOC);
+    sysbus_realize(SYS_BUS_DEVICE(&s->soc), &error_fatal);
+
+    sc = STM32L4X1_SOC_GET_CLASS(&s->soc);
+    armv7m_load_kernel(s->soc.armv7m.cpu, machine->kernel_filename, 0,
+                       sc->flash_size);
+
+    object_initialize_child(OBJECT(machine), "led", &s->led, TYPE_LED);
+    led = DEVICE(&s->led);
+    qdev_prop_set_string(led, "color", "green");
+    qdev_prop_set_bit(led, "gpio-active-high", true);
+    qdev_realize(led, NULL, &error_fatal);
+    qdev_connect_gpio_out(DEVICE(&s->soc.gpio[1]), 13,
+                          qdev_get_gpio_in(led, 0));
+
+    if (s->trace) {
+        stm32l4x1_soc_trace(&s->soc, OBJECT(machine), s->trace);
+    }
+}
+
+static char *nucleo_l431rb_get_trace(Object *obj, Error **errp)
+{
+    return g_strdup(NUCLEO_L431RB(obj)->trace);
+}
+
+static void nucleo_l431rb_set_trace(Object *obj, const char *value, Error **errp)
+{
+    NucleoL431rbMachineState *s = NUCLEO_L431RB(obj);
+
+    g_free(s->trace);
+    s->trace = g_strdup(value);
+}
+
+static void nucleo_l431rb_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    static const char *valid_cpus[] = {
+        ARM_CPU_TYPE_NAME("cortex-m4"),
+        NULL,
+    };
+
+    mc->desc = "ST NUCLEO-L431RB (STM32L431RB)";
+    mc->init = nucleo_l431rb_init;
+    mc->valid_cpu_types = valid_cpus;
+    mc->default_cpus = 1;
+    mc->default_ram_size = 0;
+    mc->default_ram_id = NULL;
+
+    object_class_property_add_str(oc, "trace", nucleo_l431rb_get_trace,
+                                  nucleo_l431rb_set_trace);
+    object_class_property_set_description(oc, "trace",
+        "Chardev id of the event recorder (pads, USART traffic, NVIC)");
+}
+
+static const TypeInfo nucleo_l431rb_machine_types[] = {
+    {
+        .name = TYPE_NUCLEO_L431RB,
+        .parent = TYPE_MACHINE,
+        .instance_size = sizeof(NucleoL431rbMachineState),
+        .class_init = nucleo_l431rb_class_init,
+        .interfaces = arm_machine_interfaces,
+    },
+};
+
+DEFINE_TYPES(nucleo_l431rb_machine_types)
