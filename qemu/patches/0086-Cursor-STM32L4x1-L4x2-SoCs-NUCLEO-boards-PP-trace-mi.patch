+
+#define TYPE_STM32L4_PWR "stm32l4-pwr"
+
+OBJECT_DECLARE_SIMPLE_TYPE(Stm32l4PwrState, STM32L4_PWR)
+
+struct Stm32l4PwrState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    uint32_t cr1;
+    uint32_t cr2;
+    uint32_t cr3;
+    uint32_t cr4;
+    uint32_t sr1;
+    uint32_t sr2;
+};
+
+static uint64_t stm32l4_pwr_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Stm32l4PwrState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        return s->cr1;
+    case 0x04:
+        return s->cr2;
+    case 0x08:
+        return s->cr3;
+    case 0x0c:
+        return s->cr4;
+    case 0x10:
+        return s->sr1 | 0x8; /* VOSF: scale ready */
+    case 0x14:
+        return s->sr2;
+    default:
+        return 0;
+    }
+}
+
+static void stm32l4_pwr_write(void *opaque, hwaddr addr,
+                              uint64_t val, unsigned size)
+{
+    Stm32l4PwrState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        s->cr1 = val;
+        break;
+    case 0x04:
+        s->cr2 = val;
+        break;
+    case 0x08:
+        s->cr3 = val;
+        break;
+    case 0x0c:
+        s->cr4 = val;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s: offset 0x%x\n", __func__, (unsigned)addr);
+        break;
+    }
+}
+
+static const MemoryRegionOps stm32l4_pwr_ops = {
+    .read = stm32l4_pwr_read,
+    .write = stm32l4_pwr_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void stm32l4_pwr_reset_hold(Object *obj, ResetType type)
+{
+    Stm32l4PwrState *s = STM32L4_PWR(obj);
+
+    s->cr1 = 0x00000300;
+    s->cr2 = 0;
+    s->cr3 = 0;
+    s->cr4 = 0;
+    s->sr1 = 0;
+    s->sr2 = 0;
+}
+
+static void stm32l4_pwr_realize(DeviceState *dev, Error **errp)
+{
+    Stm32l4PwrState *s = STM32L4_PWR(dev);
+
+    memory_region_init_io(&s->mmio, OBJECT(s), &stm32l4_pwr_ops, s,
+                          TYPE_STM32L4_PWR, 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->mmio);
+}
+
+static void stm32l4_pwr_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = stm32l4_pwr_realize;
+    rc->phases.hold = stm32l4_pwr_reset_hold;
+}
+
+static const TypeInfo stm32l4_pwr_info = {
+    .name = TYPE_STM32L4_PWR,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Stm32l4PwrState),
+    .class_init = stm32l4_pwr_class_init,
+};
+
+static void stm32l4_pwr_register_types(void)
+{
+    type_register_static(&stm32l4_pwr_info);
+}
+
+type_init(stm32l4_pwr_register_types)
