diff --git a/hw/ssi/stm32l4_spi.c b/hw/ssi/stm32l4_spi.c
new file mode 100644
index 0000000..2e749f0
--- /dev/null
+++ b/hw/ssi/stm32l4_spi.c
@@ -0,0 +1,129 @@
+/*
+ * STM32L4 SPI minimal model
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/ssi/stm32l4_spi.h"
+#include "hw/misc/pp_trace.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+
+#define SR_TXE  (1 << 1)
+#define SR_RXNE (1 << 0)
+
+static void stm32l4_spi_update_irq(Stm32l4SpiState *s)
+{
+    qemu_set_irq(s->irq, (s->sr & (SR_TXE | SR_RXNE)) != 0);
+}
+
+static uint64_t stm32l4_spi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Stm32l4SpiState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        return s->cr1;
+    case 0x04:
+        return s->cr2;
+    case 0x08:
+        return s->sr | SR_TXE;
+    case 0x0c:
+        if (s->sr & SR_RXNE) {
+            s->sr &= ~SR_RXNE;
+            stm32l4_spi_update_irq(s);
+        }
+        return s->dr;
+    default:
+        return 0;
+    }
+}
+
+static void stm32l4_spi_write(void *opaque, hwaddr addr,
+                               uint64_t val, unsigned size)
+{
+    Stm32l4SpiState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        s->cr1 = val;
+        if (val & 0x40) {
+            s->sr |= SR_TXE;
+        }
+        break;
+    case 0x04:
+        s->cr2 = val;
+        break;
+    case 0x0c:
+        s->dr = val & 0xff;
+        if (s->ssi) {
+            s->dr = ssi_transfer(s->ssi, s->dr);
+        }
+        s->sr |= SR_RXNE;
+        pp_trace_event(PP_TRACE_SPI, s->trace_src, val & 0xff, s->dr & 0xff);
+        stm32l4_spi_update_irq(s);
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps stm32l4_spi_ops = {
+    .read = stm32l4_spi_read,
+    .write = stm32l4_spi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void stm32l4_spi_reset_hold(Object *obj, ResetType type)
+{
+    Stm32l4SpiState *s = STM32L4_SPI(obj);
+
+    s->cr1 = 0;
+    s->cr2 = 0;
+    s->sr = SR_TXE;
+    s->dr = 0;
+}
+
+static void stm32l4_spi_realize(DeviceState *dev, Error **errp)
+{
+    Stm32l4SpiState *s = STM32L4_SPI(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_io(&s->mmio, OBJECT(s), &stm32l4_spi_ops, s,
+                          TYPE_STM32L4_SPI, 0x400);
+    sysbus_init_mmio(sbd, &s->mmio);
+    sysbus_init_irq(sbd, &s->irq);
+    s->ssi = ssi_create_bus(dev, "spi0");
+    s->trace_src = pp_trace_source(object_get_canonical_path_component(OBJECT(dev)));
+}
+
+static void stm32l4_spi_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = stm32l4_spi_realize;
+    rc->phases.hold = stm32l4_spi_reset_hold;
+}
+
+static const TypeInfo stm32l4_spi_info = {
+    .name = TYPE_STM32L4_SPI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Stm32l4SpiState),
+    .class_init = stm32l4_spi_class_init,
+};
+
+static void stm32l4_spi_register_types(void)
+{
+    type_register_static(&stm32l4_spi_info);
+}
+
+type_init(stm32l4_spi_register_types)
