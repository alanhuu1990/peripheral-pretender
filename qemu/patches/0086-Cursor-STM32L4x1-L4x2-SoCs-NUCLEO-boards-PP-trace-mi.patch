diff --git a/hw/misc/stm32l4_flash.c b/hw/misc/stm32l4_flash.c
new file mode 100644
index 0000000..c393131
--- /dev/null
+++ b/hw/misc/stm32l4_flash.c
@@ -0,0 +1,112 @@
+/*
+ * STM32L4 flash interface (minimal, for HAL boot)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/core/sysbus.h"
+#include "migration/vmstate.h"
+#include "qom/object.h"
+
+#define TYPE_STM32L4_FLASH "stm32l4-flash"
+
+OBJECT_DECLARE_SIMPLE_TYPE(Stm32l4FlashState, STM32L4_FLASH)
+
+struct Stm32l4FlashState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    uint32_t acr;
+    uint32_t sr;
+    uint32_t cr;
+};
+
+static uint64_t stm32l4_flash_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Stm32l4FlashState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        return s->acr;
+    case 0x10:
+        return s->sr | 0x1; /* BSY clear, ready implied */
+    case 0x14:
+        return s->cr;
+    default:
+        return 0;
+    }
+}
+
+static void stm32l4_flash_write(void *opaque, hwaddr addr,
+                                uint64_t val, unsigned size)
+{
+    Stm32l4FlashState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        s->acr = val;
+        break;
+    case 0x14:
+        s->cr = val;
+        s->sr &= ~0x1;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s: unimplemented offset 0x%x\n",
+                      __func__, (unsigned)addr);
+        break;
+    }
+}
+
+static const MemoryRegionOps stm32l4_flash_ops = {
+    .read = stm32l4_flash_read,
+    .write = stm32l4_flash_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void stm32l4_flash_reset_hold(Object *obj, ResetType type)
+{
+    Stm32l4FlashState *s = STM32L4_FLASH(obj);
+
+    s->acr = 0;
+    s->sr = 0;
+    s->cr = 0;
+}
+
+static void stm32l4_flash_realize(DeviceState *dev, Error **errp)
+{
+    Stm32l4FlashState *s = STM32L4_FLASH(dev);
+
+    memory_region_init_io(&s->mmio, OBJECT(s), &stm32l4_flash_ops, s,
+                          TYPE_STM32L4_FLASH, 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->mmio);
+}
+
+static void stm32l4_flash_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = stm32l4_flash_realize;
+    rc->phases.hold = stm32l4_flash_reset_hold;
+}
+
+static const TypeInfo stm32l4_flash_info = {
+    .name = TYPE_STM32L4_FLASH,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Stm32l4FlashState),
+    .class_init = stm32l4_flash_class_init,
+};
+
+static void stm32l4_flash_register_types(void)
+{
+    type_register_static(&stm32l4_flash_info);
+}
+
+type_init(stm32l4_flash_register_types)
diff --git a/hw/misc/stm32l4_i2c.c b/hw/misc/stm32l4_i2c.c
new file mode 100644
index 0000000..04743b1
--- /dev/null
+++ b/hw/misc/stm32l4_i2c.c
@@ -0,0 +1,137 @@
+/*
+ * STM32L4 I2C (FM+) minimal model
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/misc/stm32l4_i2c.h"
+#include "hw/misc/pp_trace.h"
+#include "hw/core/irq.h"
+#include "hw/i2c/i2c.h"
+#include "migration/vmstate.h"
+
+#define ISR_TXIS   (1 << 1)
+#define ISR_RXNE   (1 << 2)
+#define ISR_TC     (1 << 6)
+#define ISR_BUSY   (1 << 15)
+
+static void stm32l4_i2c_update_irq(Stm32l4I2cState *s)
+{
+    qemu_set_irq(s->irq_ev, (s->isr & (ISR_TXIS | ISR_RXNE | ISR_TC)) != 0);
+}
+
+static uint64_t stm32l4_i2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Stm32l4I2cState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        return s->cr1;
+    case 0x04:
+        return s->cr2;
+    case 0x10:
+        return s->timingr;
+    case 0x18:
+        return s->isr;
+    case 0x28:
+        return s->txdr;
+    default:
+        return 0;
+    }
+}
+
+static void stm32l4_i2c_write(void *opaque, hwaddr addr,
+                               uint64_t val, unsigned size)
+{
+    Stm32l4I2cState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        s->cr1 = val;
+        if (val & 1) {
+            s->isr &= ~ISR_BUSY;
+            s->isr |= ISR_TXIS | ISR_TC;
+        }
+        break;
+    case 0x04:
+        s->cr2 = val;
+        break;
+    case 0x10:
+        s->timingr = val;
+        break;
+    case 0x1c:
+        s->isr &= ~val;
+        stm32l4_i2c_update_irq(s);
+        break;
+    case 0x28:
+        s->txdr = val;
+        s->isr |= ISR_TXIS;
+        pp_trace_event(PP_TRACE_I2C_BYTE, s->trace_src, val & 0xff, 0);
+        stm32l4_i2c_update_irq(s);
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s: offset 0x%x\n", __func__, (unsigned)addr);
+        break;
+    }
+}
+
+static const MemoryRegionOps stm32l4_i2c_ops = {
+    .read = stm32l4_i2c_read,
+    .write = stm32l4_i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void stm32l4_i2c_reset_hold(Object *obj, ResetType type)
+{
+    Stm32l4I2cState *s = STM32L4_I2C(obj);
+
+    s->cr1 = 0;
+    s->cr2 = 0;
+    s->timingr = 0;
+    s->isr = 0;
+    s->txdr = 0;
+}
+
+static void stm32l4_i2c_realize(DeviceState *dev, Error **errp)
+{
+    Stm32l4I2cState *s = STM32L4_I2C(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_io(&s->mmio, OBJECT(s), &stm32l4_i2c_ops, s,
+                          TYPE_STM32L4_I2C, 0x400);
+    sysbus_init_mmio(sbd, &s->mmio);
+    sysbus_init_irq(sbd, &s->irq_ev);
+    sysbus_init_irq(sbd, &s->irq_er);
+    s->trace_src = pp_trace_source(object_get_canonical_path_component(OBJECT(dev)));
+}
+
+static void stm32l4_i2c_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = stm32l4_i2c_realize;
+    rc->phases.hold = stm32l4_i2c_reset_hold;
+}
+
+static const TypeInfo stm32l4_i2c_info = {
+    .name = TYPE_STM32L4_I2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Stm32l4I2cState),
+    .class_init = stm32l4_i2c_class_init,
+};
+
+static void stm32l4_i2c_register_types(void)
+{
+    type_register_static(&stm32l4_i2c_info);
+}
+
+type_init(stm32l4_i2c_register_types)
